{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": [
    "dist/",
    "out/",
    "node_modules/",
    ".vscode-test/",
    "coverage/",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs"
  ]
}
