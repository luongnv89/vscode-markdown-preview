{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "error",
    "max-lines-per-function": [
      "error",
      {
        "max": 50
      }
    ],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/test/**"],
      "rules": {
        "max-lines-per-function": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/",
    "out/",
    "node_modules/",
    ".vscode-test/",
    "coverage/",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs"
  ]
}
