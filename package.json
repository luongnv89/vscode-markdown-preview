{
  "name": "markdown-preview-pro",
  "displayName": "Markdown Preview Pro",
  "description": "Clean, minimal markdown preview with syntax highlighting, mermaid diagrams, math rendering, and interactive features",
  "version": "0.9.4",
  "publisher": "luongnv89",
  "license": "MIT",
  "homepage": "https://luongnv.com/vscode-markdown-preview/",
  "repository": {
    "type": "git",
    "url": "https://github.com/luongnv89/vscode-markdown-preview"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "preview",
    "mermaid",
    "katex",
    "math",
    "excalidraw",
    "preview"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:markdownPreviewPro.exportToHtml",
    "onCommand:markdownPreviewPro.exportToPdf"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownPreviewPro.showPreview",
        "title": "Markdown Preview Pro: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownPreviewPro.showPreviewToSide",
        "title": "Markdown Preview Pro: Open Preview to Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownPreviewPro.exportToHtml",
        "title": "Markdown Preview Pro: Export to HTML",
        "icon": "$(file-code)"
      },
      {
        "command": "markdownPreviewPro.exportToPdf",
        "title": "Markdown Preview Pro: Export to PDF",
        "icon": "$(file-pdf)"
      }
    ],
    "keybindings": [
      {
        "command": "markdownPreviewPro.showPreviewToSide",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == markdown",
          "command": "markdownPreviewPro.showPreviewToSide",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == markdown",
          "command": "markdownPreviewPro.exportToHtml",
          "group": "export@1"
        },
        {
          "when": "resourceLangId == markdown",
          "command": "markdownPreviewPro.exportToPdf",
          "group": "export@2"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "markdownPreviewPro.showPreviewToSide",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == markdown",
          "command": "markdownPreviewPro.exportToHtml",
          "group": "export@1"
        },
        {
          "when": "resourceLangId == markdown",
          "command": "markdownPreviewPro.exportToPdf",
          "group": "export@2"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "markdownPreviewPro.showPreviewToSide",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == markdown",
          "command": "markdownPreviewPro.exportToHtml",
          "group": "export@1"
        },
        {
          "when": "resourceLangId == markdown",
          "command": "markdownPreviewPro.exportToPdf",
          "group": "export@2"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Preview Pro",
      "properties": {
        "markdownPreviewPro.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Enable bidirectional scroll synchronization between editor and preview"
        },
        "markdownPreviewPro.enableMermaid": {
          "type": "boolean",
          "default": true,
          "description": "Enable Mermaid diagram rendering"
        },
        "markdownPreviewPro.enableKatex": {
          "type": "boolean",
          "default": true,
          "description": "Enable KaTeX math rendering"
        },
        "markdownPreviewPro.enableExcalidraw": {
          "type": "boolean",
          "default": true,
          "description": "Enable Excalidraw diagram rendering in code blocks"
        },
        "markdownPreviewPro.enableCheckboxes": {
          "type": "boolean",
          "default": true,
          "description": "Enable interactive task list checkboxes"
        },
        "markdownPreviewPro.typographer": {
          "type": "boolean",
          "default": true,
          "description": "Enable smart quotes and typographic replacements"
        },
        "markdownPreviewPro.lineBreaks": {
          "type": "boolean",
          "default": false,
          "description": "Convert newlines in paragraphs to <br> tags"
        },
        "markdownPreviewPro.showFrontmatter": {
          "type": "string",
          "default": "card",
          "enum": [
            "card",
            "none"
          ],
          "enumDescriptions": [
            "Display YAML frontmatter as a styled metadata card",
            "Hide frontmatter from the preview"
          ],
          "description": "How to display YAML frontmatter in the preview"
        },
        "markdownPreviewPro.allowRemoteImages": {
          "type": "boolean",
          "default": false,
          "description": "Allow remote (https:) images in the preview. Off by default so a document cannot load remote images (which would leak that the preview was opened and the viewer's IP). Enable only if you need remote images — mirrors the remote-content opt-in of VS Code's built-in markdown preview."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "build:landing": "node scripts/generate-landing.cjs",
    "lint": "eslint src/ webview/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile && npm run compile:test",
    "test": "node ./out/test/runTest.js",
    "precoverage": "npm run compile && npm run compile:test",
    "coverage": "c8 node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "c8": "^12.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.9.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "mini-css-extract-plugin": "^2.10.2",
    "mocha": "^12.0.2",
    "prettier": "^3.9.6",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@excalidraw/utils": "^0.1.5",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.0",
    "katex": "^0.16.9",
    "markdown-it": "^14.3.2",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.0.0",
    "puppeteer-core": "^25.11.0",
    "yaml": "^2.9.1"
  }
}
